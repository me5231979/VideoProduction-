# Copy to .env and fill in. Never commit .env.

# Claude (scriptwriter)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Synthesia (avatar video). Enterprise/Creator plan required for API access.
SYNTHESIA_API_KEY=
SYNTHESIA_DEFAULT_AVATAR=anna_costume1_cameraA
SYNTHESIA_DEFAULT_BACKGROUND=off_white
SYNTHESIA_TEST_MODE=true

# ElevenLabs (narration TTS for non-avatar segments)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Delivery: finished videos are copied here.
# Leave blank to default to ~/Desktop on your OS (Mac, Linux, Windows).
# Set this if your Desktop lives elsewhere (e.g. OneDrive: ~/OneDrive/Desktop).
DESKTOP_DIR=

# Local working directories (defaults are fine)
WORK_DIR=./work
OUTPUT_DIR=./output
