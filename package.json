{
  "name": "training-video-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Programmatic training-video production: Claude scriptwriter → Synthesia avatar + ElevenLabs narration → FFmpeg composition → Box delivery.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --import tsx/esm src/cli.ts",
    "produce": "node --import tsx/esm src/cli.ts produce",
    "script": "node --import tsx/esm src/cli.ts script",
    "narrate": "node --import tsx/esm src/cli.ts narrate",
    "upload": "node --import tsx/esm src/cli.ts upload"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "box-node-sdk": "^3.7.0",
    "dotenv": "^16.4.5",
    "fluent-ffmpeg": "^2.1.3",
    "undici": "^6.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
